# App
APP_NAME=Vekro Backend
ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=replace-with-generated-hex-token

# Database (Neon)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
ALEMBIC_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require
# The app and every script use ALEMBIC_DATABASE_URL before DATABASE_URL when it is set: point both at
# the same database. The scripts print which one they use (#279).
DATABASE_ECHO=false

# Daraja (M-Pesa)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# Must be public HTTPS; `make tunnel` serves this host (docs/demo-modes.md).
DARAJA_CALLBACK_URL=https://<your-static-domain>.ngrok-free.dev/payments/mpesa/callback
# #224: real STK push and STK-query confirmation (off = stub gateway). Needs every DARAJA_* value
# above and an https callback URL.
DARAJA_ENABLED=false
DARAJA_TIMEOUT_SECONDS=15
# Opt-in live test (pytest -m live -k daraja): sends ONE KES 1 sandbox STK push to this phone.
RUN_DARAJA_LIVE_TESTS=
DARAJA_LIVE_TEST_PHONE=

# USSD (M23, docs/ussd.md). AT's USSD requests are unsigned: the callback URL is
# https://<host>/ussd/africastalking/<USSD_CALLBACK_TOKEN>. Blank turns USSD off.
USSD_CALLBACK_TOKEN=
# Optional extra check: comma-separated caller IPs. Enforced only behind the Cloudflare tunnel with
# USSD_CLIENT_IP_HEADER=cf-connecting-ip (#289); otherwise it stays off (X-Forwarded-For is spoofable).
USSD_ALLOWED_IPS=
USSD_CLIENT_IP_HEADER=
USSD_SESSION_SECONDS=180

# M24 B4: the state timeouts in minutes for a class demo (refused in production).
DEMO_FAST_TIMEOUTS=false

# Africa's Talking
# Default username `sandbox` uses the sandbox SMS API. Sandbox smoke tests do not
# guarantee real handset delivery unless the number is approved/configured in AT.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Optional pytest smoke only; leave unset for normal app runtime.
# RUN_AFRICASTALKING_LIVE_TESTS=1
# AFRICASTALKING_LIVE_DESTINATION_PHONE=+2547XXXXXXXX

# CORS / frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Session / auth cookies
SESSION_COOKIE_NAME=vekro_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=604800
CSRF_COOKIE_NAME=vekro_csrf
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token

# Login brute-force protection
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Buyer sign-in with an SMS code (POST /auth/phone/request-code, /auth/phone/verify).
PHONE_CODE_TTL_SECONDS=300
PHONE_CODE_RESEND_SECONDS=30
PHONE_CODE_MAX_ATTEMPTS=5
PHONE_CODE_LOCKOUT_SECONDS=300
PHONE_CODE_HOURLY_LIMIT=5
# Local development and e2e only: return the code in the API response. Refused in production.
PHONE_CODE_DEV_ECHO=false

# Custody architecture
CUSTODY_MODE=tier_2
CUSTODY_COLLECTION_RAIL_PRIORITY=simulated
CUSTODY_PAYOUT_RAIL_PRIORITY=simulated
ALLOW_LIVE_PAYOUTS=false
# Shared secret for POST /transactions/payment-callback (X-Payment-Callback-Secret header).
# Blank = refused in production, open in development (simulated rail / e2e tests).
PAYMENT_CALLBACK_SECRET=
SIMULATED_COLLECTION_DEFAULT_SCENARIO=success
SIMULATED_PAYOUT_DEFAULT_SCENARIO=success
SIMULATED_TRIGGER_PREFIX=sim:
# Example priorities when live rails are configured:
# CUSTODY_COLLECTION_RAIL_PRIORITY=loop,pesapal,simulated
# CUSTODY_PAYOUT_RAIL_PRIORITY=loop,simulated
# Routing examples from planning docs:
# COLLECTION_RAIL_PRIORITY=loop,pesapal,daraja,simulated
# PAYOUT_RAIL_PRIORITY=loop,simulated

# LOOP rail
LOOP_ENABLED=false
LOOP_BASE_URL=
LOOP_CLIENT_ID=
LOOP_CLIENT_SECRET=
LOOP_SHORTCODE=
LOOP_PASSKEY=

# Pesapal (sandbox). Card payments (#251) need PESAPAL_ENABLED=true, the keys, PESAPAL_IPN_ID and
# FRONTEND_URL (the buyer returns to FRONTEND_URL/pay/return). Sandbox keys: the public demo
# merchant at developer.pesapal.com/api3-demo-keys.txt. Register the IPN once (stores the id here):
#   PESAPAL_* exported; python -m app.services.custody.pesapal_ipn_registration \
#     --callback-url https://<tunnel-or-api-host>/payments/pesapal/ipn --notification-type GET
PESAPAL_ENABLED=false
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Used only by the M15 custody-registry rail; card checkout returns buyers to FRONTEND_URL.
PESAPAL_CALLBACK_URL=https://<your-static-domain>.ngrok-free.dev/api/webhooks/pesapal/callback
PESAPAL_IPN_ID=

# IntaSend rail
INTASEND_ENABLED=false
INTASEND_BASE_URL=
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_SECRET=

# eConfirm provider (Tier 1 live custody - M20)
ECONFIRM_ENABLED=false
ECONFIRM_BASE_URL=https://api.econfirm.co.ke/api/v1
ECONFIRM_API_KEY=
ECONFIRM_API_SECRET=
ECONFIRM_TIMEOUT_SECONDS=15
# New transactions use eConfirm only inside this KES band; others stay simulated.
ECONFIRM_MIN_AMOUNT=100
ECONFIRM_MAX_AMOUNT=1000
ECONFIRM_POLL_INTERVAL_SECONDS=10
# Users register by phone; eConfirm requires party e-mails, so this is used for both.
ECONFIRM_FALLBACK_EMAIL=
# Fernet key(s), comma-separated, newest first. Required when ECONFIRM_ENABLED=true.
ECONFIRM_CODE_ENCRYPTION_KEY=
# Optional pytest smoke only (`pytest -m live -k econfirm`); leave unset for runtime.
RUN_ECONFIRM_LIVE_TESTS=false
# The KES 100 fund-and-reverse round trip moves real money; it also needs:
# ECONFIRM_LIVE_MONEY_CONFIRM=KES100
# ECONFIRM_LIVE_PAYER_PHONE=+2547XXXXXXXX
# ECONFIRM_LIVE_RECEIVER_PHONE=+2547XXXXXXXX

# --- M21 verifiable escrow ledger (anchoring) ---
# HMAC key(s) naming admins in anchored payloads as admin_ref, so buyers and sellers never see an
# admin's UUID. Comma-separated, newest first, each 32+ characters. Required when
# ENVIRONMENT=production; elsewhere a fixed development key is used (with a warning) when blank.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Back it up: without it, admin refs in old payloads can no longer be resolved to an admin.
ANCHOR_ADMIN_REF_SECRET=
# Raise instead of logging when a money fact has no anchor event. The test suite turns it on.
ANCHOR_STRICT_EVENTS=false

# M21 A5 anchoring worker (python -m app.jobs.anchoring run-once|run-loop). Off by default: events
# are still recorded, nothing is sent to a chain. Enabling it requires ANCHOR_ADMIN_REF_SECRET too.
# Local: anvil --port 8545 && make anvil-deploy (registry 0x5FbDB2315678afecb367f032d93F642f64180aa3).
# Base Sepolia (#279): registry 0xD8094faf2B44711dD372A59C288130FA8113E4DB belongs to one database,
# vekro_base_sepolia; use the .env.base-sepolia overlay for it (docs/anchoring.md section 8).
# Never point another database at it, and never anchor to Base without the maintainer's go-ahead.
ANCHOR_ENABLED=false
ANCHOR_RPC_URL=
# 31337 Anvil, 84532 Base Sepolia, 8453 Base (31337 is refused in production).
ANCHOR_CHAIN_ID=31337
ANCHOR_REGISTRY_ADDRESS=
# The anchorer key (0x + 64 hex). Secret: never logged or shown; the admin status shows its address.
ANCHOR_PRIVATE_KEY=
ANCHOR_MAX_BATCH_SIZE=1000
ANCHOR_MIN_CONFIRMATIONS=2
ANCHOR_POLL_INTERVAL_SECONDS=30
ANCHOR_FEE_BUMP_AFTER_SECONDS=120
ANCHOR_MAX_FEE_PER_GAS_GWEI=5
ANCHOR_RETRY_BACKOFF_SECONDS=60
ANCHOR_RPC_TIMEOUT_SECONDS=10
# M21 A8: payouts wait until their queued authorisation is anchored and its Merkle proof matches
# the registry root; a payout edited after anchoring halts. Needs ANCHOR_ENABLED=true, and is
# required with it in production.
ANCHOR_GATE_PAYOUTS=false

# Continue with Google (#324, docs/google-sign-in.md). Off while either is blank. Redirect URI
# registered in the Google client: {FRONTEND_URL}/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   (only to override the default above)
