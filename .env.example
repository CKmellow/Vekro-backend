APP_NAME=Vekro Backend
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Neon PostgreSQL DSN (do not commit real credentials)
DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_ECHO=false

# Placeholder secret for future session/auth milestones
SECRET_KEY=replace-this-with-a-long-random-value
