# App
APP_NAME=Vekro Backend
ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=replace-with-generated-hex-token

# Database (Neon)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
ALEMBIC_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require
DATABASE_ECHO=false

# Daraja (M-Pesa)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://<your-ngrok-subdomain>.ngrok-free.app/api/payments/mpesa/callback

# Africa's Talking
# Default username `sandbox` uses the sandbox SMS API. Sandbox smoke tests do not
# guarantee real handset delivery unless the number is approved/configured in AT.
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# Optional pytest smoke only; leave unset for normal app runtime.
# RUN_AFRICASTALKING_LIVE_TESTS=1
# AFRICASTALKING_LIVE_DESTINATION_PHONE=+2547XXXXXXXX

# CORS / frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Session / auth cookies
SESSION_COOKIE_NAME=vekro_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=604800
CSRF_COOKIE_NAME=vekro_csrf
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token

# Login brute-force protection
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# Buyer sign-in with an SMS code (POST /auth/phone/request-code, /auth/phone/verify).
PHONE_CODE_TTL_SECONDS=300
PHONE_CODE_RESEND_SECONDS=30
PHONE_CODE_MAX_ATTEMPTS=5
PHONE_CODE_LOCKOUT_SECONDS=300
PHONE_CODE_HOURLY_LIMIT=5
# Local development and e2e only: return the code in the API response. Refused in production.
PHONE_CODE_DEV_ECHO=false

# Custody architecture
CUSTODY_MODE=tier_2
CUSTODY_COLLECTION_RAIL_PRIORITY=simulated
CUSTODY_PAYOUT_RAIL_PRIORITY=simulated
ALLOW_LIVE_PAYOUTS=false
# Shared secret for POST /transactions/payment-callback (X-Payment-Callback-Secret header).
# Blank = refused in production, open in development (simulated rail / e2e tests).
PAYMENT_CALLBACK_SECRET=
SIMULATED_COLLECTION_DEFAULT_SCENARIO=success
SIMULATED_PAYOUT_DEFAULT_SCENARIO=success
SIMULATED_TRIGGER_PREFIX=sim:
# Example priorities when live rails are configured:
# CUSTODY_COLLECTION_RAIL_PRIORITY=loop,pesapal,simulated
# CUSTODY_PAYOUT_RAIL_PRIORITY=loop,simulated
# Routing examples from planning docs:
# COLLECTION_RAIL_PRIORITY=loop,pesapal,daraja,simulated
# PAYOUT_RAIL_PRIORITY=loop,simulated

# LOOP rail
LOOP_ENABLED=false
LOOP_BASE_URL=
LOOP_CLIENT_ID=
LOOP_CLIENT_SECRET=
LOOP_SHORTCODE=
LOOP_PASSKEY=

# Pesapal collection rail (sandbox)
PESAPAL_ENABLED=false
PESAPAL_BASE_URL=https://cybqa.pesapal.com/pesapalv3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=https://<your-ngrok-subdomain>.ngrok-free.app/api/webhooks/pesapal/callback
PESAPAL_IPN_ID=

# IntaSend rail
INTASEND_ENABLED=false
INTASEND_BASE_URL=
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_SECRET=

# eConfirm provider (Tier 1 live custody - M20)
ECONFIRM_ENABLED=false
ECONFIRM_BASE_URL=https://api.econfirm.co.ke/api/v1
ECONFIRM_API_KEY=
ECONFIRM_API_SECRET=
ECONFIRM_TIMEOUT_SECONDS=15
# New transactions use eConfirm only inside this KES band; others stay simulated.
ECONFIRM_MIN_AMOUNT=100
ECONFIRM_MAX_AMOUNT=1000
ECONFIRM_POLL_INTERVAL_SECONDS=10
# Users register by phone; eConfirm requires party e-mails, so this is used for both.
ECONFIRM_FALLBACK_EMAIL=
# Fernet key(s), comma-separated, newest first. Required when ECONFIRM_ENABLED=true.
ECONFIRM_CODE_ENCRYPTION_KEY=
# Optional pytest smoke only (`pytest -m live -k econfirm`); leave unset for runtime.
RUN_ECONFIRM_LIVE_TESTS=false
# The KES 100 fund-and-reverse round trip moves real money; it also needs:
# ECONFIRM_LIVE_MONEY_CONFIRM=KES100
# ECONFIRM_LIVE_PAYER_PHONE=+2547XXXXXXXX
# ECONFIRM_LIVE_RECEIVER_PHONE=+2547XXXXXXXX

# --- M21 verifiable escrow ledger (anchoring) ---
# HMAC key(s) naming admins in anchored payloads as admin_ref, so buyers and sellers never see an
# admin's UUID. Comma-separated, newest first, each 32+ characters. Required when
# ENVIRONMENT=production; elsewhere a fixed development key is used (with a warning) when blank.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Back it up: without it, admin refs in old payloads can no longer be resolved to an admin.
ANCHOR_ADMIN_REF_SECRET=
# Raise instead of logging when a money fact has no anchor event. The test suite turns it on.
ANCHOR_STRICT_EVENTS=false
