# App
APP_NAME=Vekro Backend
ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=replace-with-generated-hex-token

# Database (Neon)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
ALEMBIC_DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require
DATABASE_ECHO=false

# Daraja (M-Pesa)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://<your-ngrok-subdomain>.ngrok-free.app/api/payments/mpesa/callback

# Africa's Talking
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# CORS / frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
