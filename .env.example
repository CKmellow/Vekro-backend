# App
APP_NAME=Vekro Backend
ENVIRONMENT=development
APP_HOST=127.0.0.1
APP_PORT=8000
SECRET_KEY=replace-with-generated-hex-token

# Database (Neon)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/<dbname>?ssl=require
ALEMBIC_DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>/<dbname>?sslmode=require&channel_binding=require
DATABASE_ECHO=false

# Daraja (M-Pesa)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://<your-ngrok-subdomain>.ngrok-free.app/api/payments/mpesa/callback

# Africa's Talking
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# CORS / frontend
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

# Session / auth cookies
SESSION_COOKIE_NAME=vekro_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=604800
CSRF_COOKIE_NAME=vekro_csrf
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token

# Login brute-force protection
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
