# Production settings for deploy/compose.yaml (M26, #285; docs/hosting.md).
# Copy to deploy/.env on the server and fill in. Never commit the filled file.
# The API refuses to start when a production rule is broken (app/core/settings.py), and says which.

# --- Compose ---------------------------------------------------------------------------------------
# How the internet reaches the VM (docs/hosting.md section 4): tunnel (Cloudflare Tunnel, no inbound
# ports, recommended) or caddy (ports 80 and 443 open, Caddy gets the certificates).
COMPOSE_PROFILES=tunnel
APP_DOMAIN=app.vekro.me
API_DOMAIN=api.vekro.me
# tunnel: the token from Cloudflare Zero Trust > Networks > Tunnels > vekro > (install connector).
CLOUDFLARE_TUNNEL_TOKEN=
# caddy only: Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=
# Long random string: openssl rand -hex 32
POSTGRES_PASSWORD=
# Images. deploy/deploy.sh writes these on every rollout (CD); until then the API is built here and
# the web app comes from GHCR. Pin a tag to roll back.
# VEKRO_API_IMAGE=ghcr.io/ckmellow/vekro-api:<sha>
# VEKRO_WEB_IMAGE=ghcr.io/ckmellow/vekro-web:<sha>

# --- App -------------------------------------------------------------------------------------------
APP_NAME=Vekro
ENVIRONMENT=production
# openssl rand -hex 32
SECRET_KEY=
FRONTEND_URL=https://app.vekro.me
CORS_ORIGINS=https://app.vekro.me
CORS_ALLOW_CREDENTIALS=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
PHONE_CODE_DEV_ECHO=false
DEMO_FAST_TIMEOUTS=false
# Shared secret for POST /transactions/payment-callback (simulated rail tooling). openssl rand -hex 32
PAYMENT_CALLBACK_SECRET=

# --- Money rails -----------------------------------------------------------------------------------
# Live payouts stay off until Cyprian decides otherwise.
ALLOW_LIVE_PAYOUTS=false
# tier_2 (default) or tier_1; rail order, comma-separated (docs/custody-tiers.md).
# CUSTODY_MODE=tier_2
# CUSTODY_COLLECTION_RAIL_PRIORITY=simulated
# CUSTODY_PAYOUT_RAIL_PRIORITY=simulated

# M-Pesa (Daraja). The callback must be public HTTPS: the API domain.
DARAJA_ENABLED=false
DARAJA_ENV=production
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://api.vekro.me/payments/mpesa/callback

# Cards (Pesapal). Register the IPN once after the first boot (docs/hosting.md, step 6).
PESAPAL_ENABLED=false
PESAPAL_BASE_URL=https://pay.pesapal.com/v3
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PESAPAL_CALLBACK_URL=

# eConfirm (tier-1 custody). Off until the live smoke test has been run with Cyprian.
ECONFIRM_ENABLED=false
ECONFIRM_BASE_URL=
ECONFIRM_API_KEY=
ECONFIRM_API_SECRET=
ECONFIRM_CODE_ENCRYPTION_KEY=
# Amount guard still to be decided by Cyprian (1000 default vs 500000).
# ECONFIRM_MAX_AMOUNT=1000

# --- SMS and USSD (Africa's Talking) ---------------------------------------------------------------
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# Only a sender ID registered for this username; blank uses AT's default.
AFRICASTALKING_SENDER_ID=
# The USSD callback is https://api.vekro.me/ussd/africastalking/<token>. openssl rand -hex 24
USSD_CALLBACK_TOKEN=
USSD_ALLOWED_IPS=
USSD_TRUST_FORWARDED_FOR=true

# --- Public record (anchoring) ---------------------------------------------------------------------
# Required in production even with anchoring off: keys used to hide admin and provider ids.
# One or more comma-separated keys of 32+ characters (openssl rand -hex 32).
ANCHOR_ADMIN_REF_SECRET=
# Base Sepolia registry (#279, docs/anchoring.md section 8). It belongs to the vekro_base_sepolia
# database: restore that database here before switching anchoring on (docs/hosting.md), and copy
# ANCHOR_ADMIN_REF_SECRET above from the laptop's .env.base-sepolia. A fresh database pointed at this
# registry halts at its first batch and, with the gate on, holds every payout.
ANCHOR_ENABLED=true
ANCHOR_GATE_PAYOUTS=true
ANCHOR_RPC_URL=https://sepolia.base.org
ANCHOR_CHAIN_ID=84532
ANCHOR_REGISTRY_ADDRESS=0xD8094faf2B44711dD372A59C288130FA8113E4DB
# The anchorer key for 0x7fA08E3f34De07950b78C7A463DAFa91e31eE391 (from the laptop's .env).
ANCHOR_PRIVATE_KEY=
